config {
  type: "table",
  schema: "gold",
  database: "data-engineering-496314",
  name: "avg_fare_by_borough",
  tags: ['gold']
}

SELECT
  pickup_borough,
  dropoff_borough,
  COUNT(*) AS trips_count,
  AVG(fare_amount) AS avg_fare,
  AVG(fare_per_mile) AS avg_fare_per_mile
FROM
  ${ref('silver', 'yellow_taxi_trips')}
GROUP BY
  pickup_borough,
  dropoff_borough
